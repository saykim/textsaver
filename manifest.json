{
  "name": "Text Saver",
  "version": "2.6.6",
  "description": "Save text snippets with tags and easily access them when needed",
  "default_locale": "ko",
  "manifest_version": 3,
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html?view=popup",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "contextMenus",
    "notifications",
    "activeTab",
    "alarms",
    "scripting",
    "identity",
    "sidePanel",
    "windows"
  ],
  "host_permissions": [
    "https://accounts.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "side_panel": {
    "default_path": "popup.html?view=panel"
  },
  "oauth2": {
    "client_id": "138881851224-6v532ehts4oh3l4j678566rjmnslb339.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "commands": {
    "toggle-auto-complete": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "Toggle Text Saver // auto-complete feature"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+L",
        "mac": "Alt+L"
      },
      "description": "Open Text Saver Side Panel"
    }
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "author": "BDK-KIMS-9587-TS",
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "js/utils.js",
        "js/content.js"
      ],
      "css": [
        "css/content.css"
      ],
      "all_frames": false,
      "match_about_blank": false,
      "run_at": "document_end"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; connect-src 'self' https://accounts.google.com https://www.googleapis.com;",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals;"
  }
}
